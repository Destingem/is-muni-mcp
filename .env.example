# IS MUNI MCP — vzor nastavení (zkopírujte do .env nebo exportujte v shellu).
#
# Běžní uživatelé nic z toho nepotřebují — stačí `is-muni-mcp login`,
# který session uloží do ~/.config/is-muni-mcp/cookie.txt.
# Níže jsou alternativy pro servery / CI (mají přednost před uloženou session).
# Nikdy necommitujte reálné hodnoty!

# Varianta A: celý Cookie řetězec z prohlížeče (is.muni.cz → Cookies)
ISMU_COOKIE="__Host-issession=...; __Host-iscreds=..."

# Varianta B: po částech
# ISMU_SESSION=...
# ISMU_CREDS=...

# Varianta C: soubor s řetězcem (první neprázdný řádek)
# ISMU_COOKIE_FILE=~/.config/is-muni-mcp/cookie.txt

# Kam ukládat stažené binární soubory (nepovinné)
# ISMU_DOWNLOAD_DIR=~/.cache/is-muni-mcp
